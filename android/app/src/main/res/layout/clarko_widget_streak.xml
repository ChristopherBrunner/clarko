<?xml version="1.0" encoding="utf-8"?>
<!-- Compact "streak" widget (2x1): the streak on the left instead of the dose
     names; the first two doses on the right, one above the other in the same
     order (and with the same sun/moon) as in the other Clarko widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/streak_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="🔥 12"
            android:textColor="@color/widget_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/streak_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="day streak"
            android:textColor="@color/widget_subtitle"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dose0_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dose0_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sun"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/dose0_check"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_check_empty"
                android:contentDescription="Toggle taken" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dose1_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dose1_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_moon"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/dose1_check"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_check_empty"
                android:contentDescription="Toggle taken" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
